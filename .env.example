# Copy to .env and fill in. Empty keys disable that provider/source (no crash).

# LLM (required for real pieces): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional LLM fallbacks
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Guardian Open Platform (full article bodies): https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=
# football-data.org free tier (PL standings/results/fixtures): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
